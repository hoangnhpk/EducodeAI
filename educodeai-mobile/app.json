{
  "expo": {
    "name": "EduCodeAI",
    "slug": "educodeai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "educodeai",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "EduCodeAI cần quyền truy cập ảnh để cập nhật ảnh đại diện."
        }
      ],
      "expo-font"
    ],
    "android": {
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.educodeai.educodeaimobile"
    },
    "ios": {
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "EduCodeAI cần quyền truy cập ảnh để cập nhật ảnh đại diện."
      }
    },
    "extra": {
      "eas": {
        "projectId": "7447b452-946a-4b3a-9ebb-cb82a588724b"
      }
    }
  }
}
