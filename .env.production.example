# Copy thành .env.production trên VPS và thay toàn bộ giá trị CHANGE_ME.
# Không commit .env.production. Các biến VITE_* / HASHIDS_SALT được nhúng công khai vào bundle.

COMPOSE_PROJECT_NAME=educodeai
# Chỉ frontend gateway được bind vào 127.0.0.1:${APP_PORT} trên VPS.
APP_PORT=8082
DOMAIN=educodeai.top

# Database / cache
# Supabase Cloud PostgreSQL connection string. Không commit giá trị thật.
# Ví dụ: postgres://... hoặc Host=...;Port=5432;Database=postgres;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true
DATABASE_CONNECTION_STRING=CHANGE_ME_SUPABASE_CONNECTION_STRING
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
JWT_KEY=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
JWT_ISSUER=educodeai-server
JWT_AUDIENCE=educodeai-client
CORS_ALLOWED_ORIGIN=https://educodeai.top

# AI / external services
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=CHANGE_ME
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_UPLOAD_PRESET=EduCodeAI
CLOUDINARY_ORPHAN_CLEANUP_ENABLED=true
CLOUDINARY_ORPHAN_CLEANUP_DRY_RUN=true
YOUTUBE_API_KEY=CHANGE_ME
YOUTUBE_DAILY_QUOTA_LIMIT=10000

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=EduCodeAI
SMTP_SENDER_EMAIL=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
PAYMENT_MAIL_ENABLED=true
PAYMENT_MAIL_COURSE_URL=https://educodeai.top/hoc-vien/khoa-hoc-cua-toi
PAYMENT_MAIL_WITHDRAWAL_URL=https://educodeai.top/giang-vien/rut-tien
PAYMENT_MAIL_PROFILE_URL=https://educodeai.top/bo-sung-ho-so

# Authentication / application security
RECAPTCHA_SECRET_KEY=CHANGE_ME
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
FACEBOOK_APP_ID=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME
API_SECURITY_SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# Google Cloud: tạo file ./secrets/gcp-service-account.json trên VPS (chmod 600).
GCP_PROJECT_ID=CHANGE_ME
GCP_AUDIO_STAGING_BUCKET=CHANGE_ME
GCP_SERVICE_ACCOUNT_HOST_PATH=./secrets/gcp-service-account.json
GCP_SPEECH_LANGUAGE=vi-VN
GCP_SPEECH_MODEL=latest_long
GCP_SPEECH_PRICE_PER_MINUTE_USD=0.024

# Business settings
SEPAY_BANK_CODE=MB
SEPAY_ACCOUNT_NUMBER=CHANGE_ME
SEPAY_ACCOUNT_NAME=CHANGE_ME
TRIAL_DEFAULT_VIDEO_COUNT=2
OCR_TESSDATA_PATH=/app/tessdata
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest/USD
CURRENCY_DEFAULT_VND_TO_USD_RATE=25000
CURRENCY_CACHE_DURATION_HOURS=24

# Frontend build-time public configuration (không đặt server secret ở đây)
VITE_API_URL=https://educodeai.top
VITE_APP_NAME=EduCodeAI
HASHIDS_SALT=CHANGE_ME_PUBLIC_HASHIDS_SALT
VITE_FIREBASE_API_KEY=CHANGE_ME_PUBLIC_VALUE
VITE_FIREBASE_AUTH_DOMAIN=CHANGE_ME.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=CHANGE_ME
VITE_FIREBASE_STORAGE_BUCKET=CHANGE_ME.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
VITE_FIREBASE_APP_ID=CHANGE_ME
VITE_FIREBASE_MEASUREMENT_ID=CHANGE_ME
VITE_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
VITE_RECAPTCHA_SITE_KEY=CHANGE_ME_PUBLIC_SITE_KEY
